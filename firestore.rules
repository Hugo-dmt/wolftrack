rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSubjectMember(subjectId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/subjects/$(subjectId)).data.members;
    }

    // Profil utilisateur privé
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Sujets de tracking (patient)
    match /subjects/{subjectId} {
      // Lecture autorisée pour les membres, ou pour un utilisateur authentifié qui cherche un inviteCode
      allow get: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        resource.data.inviteCode != null
      );
      allow list: if isAuthenticated();

      // Création autorisée si le créateur s'inclut dans members
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.pseudo is string &&
        request.resource.data.inviteCode is string;

      // Mise à jour autorisée pour les membres existants, OU pour rejoindre via ajout de son propre uid dans members
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );

      // Suppression réservée aux membres
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;

      // Sous-collection des entrées horodatées (append-only par les membres)
      match /entries/{entryId} {
        allow read: if isSubjectMember(subjectId);
        allow create: if isSubjectMember(subjectId) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.targetDate is string &&
          request.resource.data.metric is string &&
          request.resource.data.sourceMode in ['session', 'manual'];
        allow update, delete: if isSubjectMember(subjectId);
      }
    }
  }
}
